# Copy to .env and fill in. See README.md.

# The weigh station's LAN address. Give it a DHCP reservation first:
# weighstation.local is mDNS and does not resolve from inside a container.
SCALE_IP=192.168.1.50

# The public server the tunnel dials out to.
SOHL_HOST=sohl.example.com
SOHL_SSH_PORT=22
SOHL_USER=weighstation-tunnel

# The loopback port the station appears on, on the public server. nginx
# there proxies to 127.0.0.1:<this>. Must match the authorized_keys entry.
REMOTE_PORT=8081
