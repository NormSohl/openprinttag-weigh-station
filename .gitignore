.pio/

# VS Code: ignore machine-specific files (c_cpp_properties.json, launch.json
# carry absolute toolchain paths and are regenerated by PlatformIO), but keep
# the shared editor setup in version control.
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/settings.json

# Native test harnesses clone their upstream library beside the sources.
tools/qr/QRCode/
tools/opt/tinycbor/

# Native test dependencies, cloned on demand (see tools/store/README.md)
.deps/
