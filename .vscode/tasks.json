{
    "version": "2.0.0",
    "options": {
        // Keep the ESP-IDF/PlatformIO output uncoloured-safe on Windows terminals.
        "env": { "PLATFORMIO_DISABLE_PROGRESSBAR": "false" }
    },
    "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
    },
    "tasks": [
        {
            // Ctrl+Shift+B — the bring-up loop. Pulls FIRST: fixes land on main
            // between flashes, and a plain build silently reflashes whatever is
            // already on disk, which looks exactly like "the fix didn't work".
            // -e weigh-station skips rebuilding the diag environment.
            "label": "Pull, Flash & Monitor",
            "type": "shell",
            "command": "git pull && pio run -e weigh-station --target upload --target monitor",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            // Same, without the pull — for when you have local edits you don't
            // want disturbed, or you're deliberately testing what's on disk.
            "label": "Flash & Monitor (no pull)",
            "type": "shell",
            "command": "pio run -e weigh-station --target upload --target monitor",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "pio run",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "pio run --target upload",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Monitor",
            "type": "shell",
            "command": "pio device monitor",
            "problemMatcher": []
        },
        {
            "label": "List serial ports",
            "type": "shell",
            "command": "pio device list",
            "problemMatcher": []
        },
        {
            // Clean slate: wipes flash INCLUDING LittleFS (event log, config
            // catalog, WiFi credentials, scale calibration). Re-seeds on next boot.
            "label": "Erase flash (wipes all stored data)",
            "type": "shell",
            "command": "pio run --target erase",
            "problemMatcher": []
        },
        {
            "label": "Clean build",
            "type": "shell",
            "command": "pio run --target clean",
            "problemMatcher": []
        }
    ]
}
